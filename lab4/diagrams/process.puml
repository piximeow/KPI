@startuml process
title Оформлення й оплата замовлення (UC2 + UC4)

|Клієнт (CheckoutUI)|
start
:openCheckout(customer_id)>
|Магазин|
:findByCustomer — address цього customer;
if (є хоча б одна address?) then (ні)
  :NoAddress>
  note right: «Додайте адресу доставки в профілі»
  |Клієнт (CheckoutUI)|
  stop
else (так)
  |Магазин|
  :форма: address, card / cash_on_delivery>
endif
repeat
  |Клієнт (CheckoutUI)|
  if (натискає «Підтвердити»?) then (ні, закриває форму)
    :нічого не створено;
    stop
  else (так)
    :confirmOrder(customer_id, address_id,
    payment_method, кошик)>
  endif
  |Магазин|
  :перевірки REQ-22: ліміт, форма, кошик;
  if (умова відмови?) then (так)
    :Refused(текст першої умови)>
    note right
      REQ-20 «Забагато замовлень, спробуйте за хвилину»
      REQ-19 «Оберіть адресу й спосіб оплати»
      REQ-08 «Кошик порожній»
    end note
  else (ні)
    :транзакція: lockForUpdate товарів;
    if (бракує товару / сума 0.00?) then (так)
      :rollback;
      :Refused(текст першої умови)>
      note right
        REQ-07 «product_name: доступно stock_quantity шт.»
        REQ-09 «Замовлення на 0.00 грн не оформлюється»
      end note
    else (ні)
      :order (new), order_item, −stock_quantity,
      payment (pending), для card — schedule
      (payment_id, ordered_at + 15 хв);
      if (збій запису в БД?) then (так)
        :rollback — нічого не збережено;
        :Refused>
        note right: «Не вдалося оформити замовлення, спробуйте ще раз»
      else (ні)
        :commit;
      endif
    endif
  endif
repeat while (Refused?) is (так — форма лишається) not (ні)
fork
  :OrderCreated(order_id; для card ще
  payment_id, payment_amount)>
  |Клієнт (CheckoutUI)|
  fork
    :clearCart (REQ-17);
  fork again
    if (payment_method?) then (cash_on_delivery)
      :показати номер order_id (REQ-18);
    else (card)
      :перехід на сторінку шлюзу
      (payment_id, payment_amount) (REQ-10)>
    endif
  end fork
  end
fork again
  |Магазин|
  if (payment_method?) then (card)
    repeat
      if (яка подія надійшла?) then (від шлюзу)
        |Платіжний шлюз|
        :notifyPayment(payment_id, результат, signature)>
        |Магазин|
        :notifyPayment<
        if (підпис дійсний (REQ-21)?) then (ні)
          :Rejected(підпис недійсний), без змін>
        elseif (payment ще pending?) then (ні)
          :Accepted, без змін (REQ-15)>
        elseif (результат?) then (succeeded)
          :payment → succeeded, paid_at,
          order → paid (REQ-11);
          :Accepted>
        else (failed)
          :payment → failed, order → cancelled,
          +stock_quantity (REQ-12, 14);
          :Accepted>
        endif
      else (від таймера)
        :onPaymentTimeout(payment_id)<
        if (payment ще pending?) then (так)
          :payment → failed, order → cancelled,
          +stock_quantity (REQ-13, 14);
        else (ні)
          :без змін;
        endif
      endif
    repeat while (onPaymentTimeout ще не надходив?) is (так) not (ні)
  else (cash_on_delivery)
    end
  endif
end fork
stop
@enduml