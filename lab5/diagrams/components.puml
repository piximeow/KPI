@startuml components
title Компонентна модель: оформлення й оплата замовлення (UC2 + UC4)
skinparam componentStyle uml2
skinparam nodesep 60
skinparam ranksep 70

actor "Клієнт" as Client
component "Платіжний шлюз\n(зовнішня система)" as GW
interface " " as IPage
GW -up- IPage : IPaymentPage\nсторінка оплати\n(payment_id, payment_amount)

rectangle "Онлайн-магазин (межа системи)" {
  interface " " as IPages
  interface " " as ICheckout
  interface " " as INotify
  interface " " as ICS
  interface " " as ITimer
  interface " " as INotif
  interface " " as ITimeout
  interface " " as IAddresses
  interface " " as IProducts
  interface " " as IOrders
  interface " " as IPayments
  interface " " as ISQL

  component "CheckoutUI\n(браузер)" as UI
  component "CheckoutAPI" as CAPI
  component "PaymentWebhook" as WH
  component "CheckoutService" as CS
  component "PaymentTimer" as TM
  component "PaymentService" as PS
  component "AddressRepository\n(address)" as RA
  component "ProductRepository\n(product)" as RP
  component "OrderRepository\n(order, order_item)" as RO
  component "PaymentRepository\n(payment)" as RPay
  database "ShopDB\n(customer, address, product,\norder, order_item, payment)" as DB

  UI -up- IPages : IPages\n«Оформити» · «Підтвердити»\nформа, кошик, повідомлення
  CAPI -up- ICheckout : ICheckout\nopenCheckout → форма / NoAddress\nconfirmOrder → OrderCreated / Refused
  WH -up- INotify : IPaymentNotify\nnotifyPayment → Accepted / Rejected
  CS -up- ICS : ICheckoutService\nopenCheckout · confirmOrder
  TM -up- ITimer : ITimer\nschedule
  PS -up- INotif : IPaymentNotifications\nnotifyPayment
  PS -left- ITimeout : IPaymentTimeout\nonPaymentTimeout
  RA -up- IAddresses : IAddresses\nfindByCustomer
  RP -up- IProducts : IProducts\nlockForUpdate · decreaseStock\nincreaseStock
  RO -up- IOrders : IOrders\ncountOrderedSince · insertOrder\ninsertOrderItem · findByOrder\nupdateOrderStatus
  RPay -up- IPayments : IPayments\ninsertPayment · findByIdForUpdate\nupdatePayment
  DB -up- ISQL : SQL
}

Client ..> IPages : HTTPS
Client ..> IPage : HTTPS, дані картки
UI ..> ICheckout : HTTPS
UI ..> IPage : HTTPS, перехід на оплату
GW ..> INotify : HTTPS, HMAC-SHA256

CAPI ..> ICS
WH .[norank].> INotif
CS .[norank].> ITimer
TM .[norank].> ITimeout

CS ..> IAddresses
CS ..> IProducts
CS ..> IOrders
CS ..> IPayments
PS ..> IPayments
PS ..> IOrders
PS ..> IProducts

RA ..> ISQL
RP ..> ISQL
RO ..> ISQL
RPay ..> ISQL

CAPI -[hidden]right- WH
CS -[hidden]right- TM
TM -[hidden]right- PS
PS -[hidden]down- IAddresses
@enduml